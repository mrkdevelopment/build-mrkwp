---
import { Font } from 'astro:assets';
import '../styles/global.css';
import ProgressStrip from '../components/ProgressStrip.astro';

interface Props {
  title: string;
  /** Shown in the header on every screen of a job. */
  jobNumber?: string;
  progress?: { steps: string[]; done: number };
}
const { title, jobNumber, progress } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#F8FAFC" />
    <title>{title} | MRK WP Build</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Font cssVariable="--font-outfit" />
    <Font cssVariable="--font-space-grotesk" />
  </head>
  <body class="min-h-dvh">
    <header class="border-b border-slate-200">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <span class="flex items-center gap-2.5">
          <img src="/logo.png" alt="MRK WP" width="36" height="36" class="h-9 w-9" />
          <span class="font-display text-lg font-bold tracking-tight text-navy">Build</span>
        </span>
        {jobNumber && <span class="text-sm font-semibold text-slate-600">Job <span class="font-mono text-navy">{jobNumber}</span></span>}
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
      {progress && <ProgressStrip {...progress} />}
      <div class="mx-auto mt-8 max-w-xl sm:mt-12">
        <slot />
      </div>
    </main>
  </body>
</html>
