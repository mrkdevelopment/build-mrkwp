---
// The last step before a client's design choices are sent. Five questions about how the website
// has to work, so the team can cost it (each has an "I'm not sure", so nobody is stuck), then one
// asking whether they'd like to go over the design with Matt first. Answers are saved as they are
// chosen. Sending from here finishes this part of the job.
import Heading from '../../components/Heading.astro';
import Icon from '../../components/Icon.astro';
import { QUESTIONS, WHEN, WHERE } from '../../lib/needs.ts';

interface Props {
  needs: Record<string, string>;
  error: string;
  /** The check of their current site, as saved on the job. Only used to mention tools we already found. */
  scan: unknown;
}
const { needs, error, scan } = Astro.props;

// Tools our own check recognised on their site (the names come from our list, not from their pages).
const tools = scan && typeof scan === 'object' && !Array.isArray(scan) ? (scan as { tools?: unknown }).tools : [];
const found = (Array.isArray(tools) ? tools : [])
  .filter((tool): tool is { name: string; kind: string } => !!tool && typeof tool.name === 'string' && (tool.kind === 'crm' || tool.kind === 'booking'))
  .map((tool) => tool.name)
  .slice(0, 3);
---

<div class="mx-auto max-w-2xl">
  <Heading size="headline" plain="A few last questions," payoff="then send." />
  <p class="mt-3 text-lg leading-relaxed">These tell us what your new website has to do behind the scenes, so we can cost it. There are no wrong answers.</p>
  {error && <p role="alert" class="mt-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 leading-relaxed text-amber-900">{error}</p>}

  <form method="post" action="/api/job/designs" class="mt-2" data-keep>
    {
      QUESTIONS.map((question, i) => (
        <div class="need" role="radiogroup" aria-labelledby={`need-${question.key}`} aria-describedby={question.help ? `need-help-${question.key}` : undefined}>
          <p id={`need-${question.key}`} class="need-ask">
            <span class="design-num">{i + 1}</span>
            <span>{question.ask}</span>
          </p>
          {question.help && <p id={`need-help-${question.key}`} class="need-help">{question.help}</p>}
          {question.key === 'enquiries' && found.length > 0 && <p class="need-help">Our check of your current website found {found.join(' and ')}.</p>}
          <div class="need-options">
            {
              question.options.map((option) => (
                <label class="option">
                  <input type="radio" name={`need:${question.key}`} value={option.value} checked={needs[question.key] === option.value} />
                  <span>{option.label}</span>
                </label>
              ))
            }
          </div>
          {
            question.key === 'enquiries' && (
              <div class="need-where">
                <label for="need-where" class="block font-semibold text-navy">Which one? <span class="font-normal text-slate-600">(if you know)</span></label>
                <input id="need-where" name={`need:${WHERE}`} type="text" maxlength="200" value={needs[WHERE] ?? ''} placeholder="For example: HubSpot, Mailchimp, our booking system" class="field mt-2" />
              </div>
            )
          }
          {
            question.key === 'followup' && (
              <div class="need-when">
                <label for="need-when" class="block font-semibold text-navy">When is a good time to call? <span class="font-normal text-slate-600">(optional)</span></label>
                <input id="need-when" name={`need:${WHEN}`} type="text" maxlength="200" value={needs[WHEN] ?? ''} placeholder="For example: weekday mornings" class="field mt-2" />
              </div>
            )
          }
        </div>
      ))
    }

    {/* Back on the left, the way forward on the right, as on every other step. */}
    <div class="step-buttons flex-row-reverse">
      <button type="submit" name="do" value="send" class="btn-primary">Send my choices <Icon name="arrow" /></button>
      <button type="submit" name="do" value="back" class="btn-secondary"><Icon name="left" /> Back</button>
    </div>
    <p class="mt-4 text-right text-sm leading-relaxed text-slate-600">Nothing is sent until you press "Send my choices".</p>
  </form>
</div>
