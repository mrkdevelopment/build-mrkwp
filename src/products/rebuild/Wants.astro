---
// "What you want": one optional box. Next comes the summary, where everything is sent.
import Heading from '../../components/Heading.astro';

interface Props {
  goals: string;
}
const { goals } = Astro.props;
---

<Heading plain="What should your new website" payoff="do better?" />
<form method="post" action="/api/job/business" class="mt-6" data-keep>
  <label for="goals" class="block text-lg leading-relaxed">Tell us in your own words. A sentence or two is plenty.</label>
  <textarea id="goals" name="goals" rows="6" maxlength="5000" aria-describedby="goals-help" class="field mt-3">{goals}</textarea>
  <div id="goals-help" class="mt-3 text-sm leading-relaxed text-slate-600">
    <p>For example:</p>
    <ul class="mt-1 list-disc space-y-1 pl-5">
      <li>"Get more phone calls from people nearby."</li>
      <li>"Show our prices and services clearly."</li>
      <li>"Look more up to date than our competitors."</li>
    </ul>
    <p class="mt-3">Not sure? Leave it blank and we'll work from your current site and branding.</p>
  </div>
  {/* Next comes first in the page so the Enter key presses it; the row is shown in reverse. */}
  <div class="step-buttons flex-row-reverse">
    <button type="submit" name="do" value="wants" class="btn-primary">Next <span aria-hidden="true">→</span></button>
    <button type="submit" name="do" value="back" formnovalidate class="btn-secondary"><span aria-hidden="true">←</span> Back</button>
  </div>
</form>
