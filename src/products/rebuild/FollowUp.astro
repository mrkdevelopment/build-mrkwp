---
// Shown once the choices are sent, if the client asked to go over the design with Matt first:
// a button to book a Google Meet, or a note that Matt will call. Nothing for "no thanks".
import Icon from '../../components/Icon.astro';
import { BOOKING_URL } from './config.ts';

interface Props {
  choice: 'meet' | 'call' | 'none';
  /** When they said is a good time to call. Typed by the client: shown as text only. */
  when: string;
}
const { choice, when } = Astro.props;
---

{
  choice === 'meet' && (
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-xl font-bold">Book your meeting with Matt</h2>
      <p class="mt-2 leading-relaxed">You asked to go over your design on a Google Meet video call. Pick a time that suits you.</p>
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn-primary mt-4">Choose a time <Icon name="arrow" /></a>
    </div>
  )
}
{
  choice === 'call' && (
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-xl font-bold">Matt will call you</h2>
      <p class="mt-2 leading-relaxed">You asked for a phone call to go over your design. Matt will ring the number you gave us when you signed up.</p>
      {when && <p class="mt-2 leading-relaxed">A good time, you said: <span class="font-semibold text-navy">{when}</span></p>}
    </div>
  )
}
