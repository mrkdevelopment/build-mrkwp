---
// One thing the check found, with "Change" and "Remove". No script: the fold-out is an ordinary
// <details>, and each button is its own small form.
import type { Line } from '../../lib/business.ts';

interface Props {
  line: Line;
}
const { line } = Astro.props;
const shortLink = (value: string): string => value.replace(/^https?:\/\/(www\.)?/i, '');
---

<div>
  <p class="text-sm font-semibold text-slate-600">{line.label}</p>
  {line.removed ? (
    <div class="mt-1 flex flex-wrap items-center justify-between gap-3">
      <p class="text-slate-500"><s>{line.kind === 'link' ? shortLink(line.value) : line.kind === 'logo' ? 'Logo' : line.value}</s> <span class="font-semibold">Removed</span></p>
      <form method="post" action="/api/job/business">
        <input type="hidden" name="do" value="restore" />
        <input type="hidden" name="key" value={line.key} />
        <button type="submit" class="line-button">Put back</button>
      </form>
    </div>
  ) : (
    <>
      <div class="mt-1 text-lg font-semibold break-words text-navy">
        {line.kind === 'logo' && <img src={line.value} alt="Your logo" loading="lazy" referrerpolicy="no-referrer" class="max-h-16 max-w-[12rem] rounded bg-slate-100 object-contain p-1" />}
        {line.kind === 'colour' && (
          <span class="inline-flex items-center gap-2">
            <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><rect width="28" height="28" rx="6" fill={line.value} stroke="#cbd5e1" /></svg>
            <span class="font-mono text-base">{line.value}</span>
          </span>
        )}
        {line.kind === 'link' && shortLink(line.value)}
        {line.kind === 'text' && (line.value || <span class="font-normal text-slate-500">We couldn't find this</span>)}
      </div>
      <details class="mt-2">
        <summary class="line-button inline-block cursor-pointer">{line.editable ? (line.value ? 'Change' : 'Add') : 'Not right?'}</summary>
        <div class="mt-3 space-y-3">
          {line.editable && (
            <form method="post" action="/api/job/business">
              <input type="hidden" name="do" value="change" />
              <input type="hidden" name="key" value={line.key} />
              <label class="block text-sm font-semibold text-navy" for={`change-${line.key}`}>{line.label}</label>
              <input id={`change-${line.key}`} name="value" type="text" value={line.value} maxlength="200" autocapitalize={line.kind === 'link' ? 'none' : undefined} class="field mt-1" />
              <button type="submit" class="btn-secondary mt-3">Save</button>
            </form>
          )}
          {line.key !== 'name' && (
            <form method="post" action="/api/job/business">
              <input type="hidden" name="do" value="remove" />
              <input type="hidden" name="key" value={line.key} />
              <button type="submit" class="line-button">{line.editable ? "We don't have one. Remove it" : "That's wrong. Remove it"}</button>
            </form>
          )}
        </div>
      </details>
    </>
  )}
</div>
