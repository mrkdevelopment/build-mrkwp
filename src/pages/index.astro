---
import Heading from '../components/Heading.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Your MRK WP build">
  <Heading plain="This is where your" payoff="MRK WP build happens." />
  <p class="mt-5 text-lg leading-relaxed">
    If you've signed up for a website rebuild, use the link in the email we sent you. It opens your job here.
  </p>
  <p class="mt-3 leading-relaxed">Haven't signed up yet? See how it works, and what's free.</p>
  <p class="mt-8">
    <a class="btn-secondary" href="https://www.mrkwp.com/website-rebuilds/">Website rebuilds <span aria-hidden="true">→</span></a>
  </p>
</Layout>
