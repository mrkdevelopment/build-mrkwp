{
  "name": "build-mrkwp",
  // The "MRK WP" Cloudflare account, named by Matt on 27 Nov 2026.
  "account_id": "f191aa872298dc8b110b75cb81406cab",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  // Where mrkdevelopment.net answers. Not a secret. The secrets (service account, firewall user agent,
  // SESSION_SECRET) are typed into the Cloudflare dashboard by Matt, never here.
  "vars": { "BUILD_API_URL": "https://mrkdevelopment.net/wp-json/mrkwp/v1/build" },
  // Created in the MRK WP account on 28 Nov 2026 (Oceania). The id is not a secret.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "build-mrkwp",
      "database_id": "1cb70679-1439-46e8-871c-4c348f5330eb",
      "migrations_dir": "migrations"
    }
  ],
  // No picture store: design pictures are shown straight from mrkdevelopment.net's media library.
  // Sends anything waiting in the outbox, once a minute.
  "triggers": { "crons": ["* * * * *"] },
  // "test" is only ever run on this computer (npm run dev:test), against the stand-in backend in
  // tests/fake-backend.mjs. It has its own local database so test jobs never mix with real ones.
  "env": {
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "build-mrkwp-test",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
